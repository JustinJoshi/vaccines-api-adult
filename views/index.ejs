<!doctype html>
<html>
<head>
    <title>Adult Vaccines API - Stay Protected</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
     <!-- claude style and templating -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            width: 100%;
        }

        .vaccine-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            padding: 60px 40px;
            text-align: center;
            animation: fadeIn 0.6s ease-in;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .vaccine-icon {
            width: 120px;
            height: 120px;
            margin: 0 auto 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
        }

        .vaccine-icon i {
            font-size: 60px;
            color: white;
        }

        h1 {
            color: #2d3748;
            font-size: 42px;
            font-weight: 700;
            margin-bottom: 15px;
            line-height: 1.2;
        }

        .subtitle {
            color: #718096;
            font-size: 18px;
            margin-bottom: 35px;
            line-height: 1.6;
        }

        .info-section {
            background: #f7fafc;
            border-radius: 12px;
            padding: 25px;
            margin: 30px 0;
            text-align: left;
        }

        .info-section h3 {
            color: #2d3748;
            font-size: 20px;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .info-section p {
            color: #4a5568;
            line-height: 1.8;
            margin-bottom: 10px;
        }

        .feature-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 30px 0;
        }

        .feature-item {
            background: #edf2f7;
            padding: 20px;
            border-radius: 10px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .feature-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        .feature-item i {
            font-size: 32px;
            color: #667eea;
            margin-bottom: 10px;
        }

        .feature-item h4 {
            color: #2d3748;
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .feature-item p {
            color: #718096;
            font-size: 14px;
            line-height: 1.5;
        }

        .cta-section {
            margin-top: 40px;
        }

        .cta-text {
            color: #4a5568;
            font-size: 16px;
            margin-bottom: 25px;
            font-weight: 500;
        }

        .btn-custom {
            display: inline-block;
            padding: 15px 40px;
            margin: 0 10px 10px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 50px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-login {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        .btn-login:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(102, 126, 234, 0.4);
            color: white;
            text-decoration: none;
        }

        .btn-signup {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .btn-signup:hover {
            background: #667eea;
            color: white;
            transform: translateY(-3px);
            text-decoration: none;
        }

        .btn-custom i {
            margin-right: 8px;
        }

        .disclaimer {
            margin-top: 30px;
            padding: 15px;
            background: #fff5f5;
            border-left: 4px solid #fc8181;
            border-radius: 5px;
            text-align: left;
        }

        .disclaimer p {
            color: #742a2a;
            font-size: 13px;
            margin: 0;
            line-height: 1.6;
        }

        @media (max-width: 768px) {
            .vaccine-card {
                padding: 40px 25px;
            }

            h1 {
                font-size: 32px;
            }

            .subtitle {
                font-size: 16px;
            }

            .btn-custom {
                display: block;
                margin: 10px 0;
            }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="vaccine-card">
        <div class="vaccine-icon">
            <i class="fa fa-medkit"></i>
        </div>

        <h1>Adult Vaccines API</h1>
        <p class="subtitle">Get personalized vaccine recommendations based on your age and CDC guidelines</p>

        <div class="info-section">
            <h3><i class="fa fa-info-circle"></i> How It Works</h3>
            <p>Our API provides age-appropriate vaccine recommendations for adults following CDC immunization schedules. Simply enter your age, and receive a comprehensive list of vaccines you should consider.</p>
        </div>

        <div class="feature-list">
            <div class="feature-item">
                <i class="fa fa-calendar"></i>
                <h4>Age-Based</h4>
                <p>Recommendations tailored to your specific age group</p>
            </div>
            <div class="feature-item">
                <i class="fa fa-shield"></i>
                <h4>CDC Guidelines</h4>
                <p>Based on official immunization schedules</p>
            </div>
            <div class="feature-item">
                <i class="fa fa-bolt"></i>
                <h4>Instant Results</h4>
                <p>Get your vaccine list in seconds</p>
            </div>
        </div>

        <div class="cta-section">
            <p class="cta-text">Get started by logging in or creating an account</p>
            <a href="/login" class="btn-custom btn-login">
                <i class="fa fa-sign-in"></i>Login
            </a>
            <a href="/signup" class="btn-custom btn-signup">
                <i class="fa fa-user-plus"></i>Sign Up
            </a>
        </div>

        <div class="disclaimer">
            <p><strong>Medical Disclaimer:</strong> This tool is for informational purposes only. Always consult with your healthcare provider before making decisions about vaccinations.</p>
        </div>
    </div>
</div>
</body>
</html>