<!doctype html>
<html>

<head>
    <title>Dashboard - Adult Vaccines API</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
    <!-- claude style and templating -->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 30px 20px;
        }

        .dashboard-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header-card {
            background: white;
            border-radius: 15px;
            padding: 30px 40px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .header-card h1 {
            color: #2d3748;
            font-size: 32px;
            font-weight: 700;
            margin: 0;
        }

        .header-card h1 i {
            color: #667eea;
            margin-right: 10px;
        }

        .btn-logout {
            padding: 12px 30px;
            background: #f56565;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .btn-logout:hover {
            background: #e53e3e;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(245, 101, 101, 0.3);
            color: white;
            text-decoration: none;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
        }

        .card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .card h3 {
            color: #2d3748;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

        .card h3 i {
            color: #667eea;
            margin-right: 10px;
        }

        .user-info p {
            background: #f7fafc;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            color: #4a5568;
            font-size: 14px;
        }

        .user-info strong {
            color: #2d3748;
            display: inline-block;
            min-width: 100px;
        }

        .btn-unlink,
        .btn-connect {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin-top: 15px;
        }

        .btn-unlink {
            background: #feb2b2;
            color: #742a2a;
        }

        .btn-unlink:hover {
            background: #fc8181;
            color: white;
            text-decoration: none;
        }

        .btn-connect {
            background: #9ae6b4;
            color: #22543d;
        }

        .btn-connect:hover {
            background: #68d391;
            color: white;
            text-decoration: none;
        }

        .vaccine-search {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 30px;
            color: white;
        }

        .vaccine-search h4 {
            font-size: 18px;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .search-group {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .search-group input {
            flex: 1;
            padding: 12px 15px;
            border: none;
            border-radius: 8px;
            font-size: 15px;
        }

        .search-group button {
            padding: 12px 25px;
            background: white;
            color: #667eea;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .search-group button:hover {
            background: #f7fafc;
            transform: translateY(-2px);
        }

        #vaccines {
            display: block;
            margin-top: 15px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            min-height: 50px;
        }

        .messages-section h3 {
            margin-bottom: 20px;
        }

        .messages {
            list-style: none;
            max-height: 400px;
            overflow-y: auto;
            margin-bottom: 30px;
        }

        .message {
            background: #f7fafc;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 12px;
            display: grid;
            grid-template-columns: 1fr 2fr auto auto auto auto;
            gap: 15px;
            align-items: center;
        }

        .message span {
            color: #4a5568;
            font-size: 14px;
        }

        .message i {
            font-size: 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            color: #718096;
        }

        .message .fa-thumbs-up:hover {
            color: #48bb78;
            transform: scale(1.2);
        }

        .message .fa-thumbs-down:hover {
            color: #f56565;
            transform: scale(1.2);
        }

        .message .fa-trash:hover {
            color: #e53e3e;
            transform: scale(1.2);
        }

        .add-message-form {
            background: #f7fafc;
            padding: 25px;
            border-radius: 12px;
        }

        .add-message-form h4 {
            color: #2d3748;
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        #bold {
            font-size: 40px;

        }

        #dose, #desc  {
            margin-bottom: 10px;
        }

        #less {
            font-size: 25px;
        }

        .form-row {
            margin-bottom: 15px;
        }

        .form-row input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
        }

        .form-row input:focus {
            outline: none;
            border-color: #667eea;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        @media (max-width: 968px) {
            .content-grid {
                grid-template-columns: 1fr;
            }

            .header-card {
                text-align: center;
                flex-direction: column;
                gap: 20px;
            }

            .message {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .search-group {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>
    <div class="dashboard-container">
        <div class="header-card">
            <h1><i class="fa fa-medkit"></i> Vaccine Dashboard</h1>
            <a href="/logout" class="btn-logout"><i class="fa fa-sign-out"></i> Logout</a>
        </div>

        <div class="content-grid">
            <!-- USER PROFILE -->
            <div class="card">
                <h3><i class="fa fa-user"></i> Your Profile</h3>
                <% if (user.local.email) { %>
                    <div class="user-info">
                        <p><strong>ID:</strong>
                            <%= user._id %>
                        </p>
                        <p><strong>Email:</strong>
                            <%= user.local.email %>
                        </p>
                        <p><strong>Password:</strong>
                            <%= user.local.password %>
                        </p>
                    </div>
                    <a href="/unlink/local" class="btn-unlink"><i class="fa fa-unlink"></i> Unlink Account</a>
                    <% } else { %>
                        <a href="/connect/local" class="btn-connect"><i class="fa fa-link"></i> Connect Local
                            Account</a>
                        <% } %>
            </div>

            <!-- MAIN CONTENT -->
            <div>
                <!-- VACCINE SEARCH -->
                <div class="card">
                    <div class="vaccine-search">
                        <h4><i class="fa fa-search"></i> Find Your Recommended Vaccines</h4>
                        <p style="font-size: 14px; margin-bottom: 0;">Enter your age (19+) to get personalized vaccine
                            recommendations</p>
                        <div class="search-group">
                            <input id="input" type="text" placeholder="Enter age (e.g., 25)">
                            <button><i class="fa fa-search"></i> Search</button>
                        </div>
                        <span id="vaccines"></span>
                    </div>
                </div>

                <!-- MESSAGES SECTION -->

            </div>
        </div>
    </div>
    <script src="main.js"></script>
</body>

</html>